root = true

[*.cs]
dotnet_naming_rule.fields.severity = warning
dotnet_naming_rule.fields.symbols = fields_symbols
dotnet_naming_rule.fields.style = fields_style
dotnet_naming_symbols.fields_symbols.applicable_kinds = field
dotnet_naming_symbols.fields_symbols.applicable_accessibilities = private
dotnet_naming_style.fields_style.capitalization = camel_case
dotnet_naming_style.fields_style.required_prefix = _
